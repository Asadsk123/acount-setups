{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "public/index.html", "use": "@vercel/static" },
    { "src": "public/app.js", "use": "@vercel/static" },
    { "src": "public/hrapp-remote.apk", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/hrapp-remote.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"hrapp-remote.apk\""
      },
      "dest": "/public/hrapp-remote.apk"
    },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
